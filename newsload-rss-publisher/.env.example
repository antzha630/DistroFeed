# Server
PORT=4010
NODE_ENV=development

# Distro API (staging)
DISTRO_API_ENDPOINT=https://staging.example.com/api/stories
DISTRO_API_KEY=your-kite-ai-newsload-api-key

# RSS Feed
RSS_FEED_URL=https://medium.com/feed/@kite-ai

# Polling
POLL_INTERVAL_MINUTES=10
MAX_ITEMS_PER_POLL=20
REQUEST_TIMEOUT_MS=10000

# Backfill
BACKFILL_LIMIT=100

# Optional
DRY_RUN=false
LOG_LEVEL=info
